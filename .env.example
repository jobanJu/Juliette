# Connexion à la base Supabase de Juliette.
# Copie ce fichier en .env.local et complète la dernière ligne.

# Publiques : elles partent dans le navigateur, c'est normal et sans risque.
NEXT_PUBLIC_SUPABASE_URL=https://fbzovjwzdmabekbnasnv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_69mdN67VbGAWwO0pzzvyjA_sYNHp_X9

# SECRÈTE : contourne toutes les règles d'accès de la base. Elle ne doit jamais
# apparaître côté navigateur, ni dans git. À récupérer dans Supabase →
# Project Settings → API → service_role, et à coller ici dans .env.local.
SUPABASE_SERVICE_ROLE_KEY=

# Envoi des commandes fournisseurs par e-mail via Mailjet.
MAILJET_API_KEY=
MAILJET_API_SECRET=
